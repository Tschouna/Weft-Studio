#include <windows.h>
#include "resource.h"

IDI_APP ICON "icon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Jonah Scherrer"
      VALUE "FileDescription", "Snowfall - snow for your desktop"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "Snowfall"
      VALUE "OriginalFilename", "Snowfall.exe"
      VALUE "ProductName", "Snowfall"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
